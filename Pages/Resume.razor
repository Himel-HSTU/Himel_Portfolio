@page "/resume"
@inject IJSRuntime JS

<PageTitle>Resume / CV — @PortfolioData.FullName | Software Engineer</PageTitle>

<section class="section-block">
    <div class="container-frame">
        <!-- Top CV Action Bar -->
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-grid); margin-bottom: 2.5rem;">
            <div>
                <div class="section-index-tag">THE JOURNEY // SNAPSHOT</div>
                <h1 class="section-title" style="margin-bottom: 0.35rem;">@PortfolioData.FullName</h1>
                <p style="font-family: var(--font-display); font-size: 1.2rem; color: var(--accent-primary); font-weight: 600; margin-bottom: 0.35rem;">
                    @PortfolioData.PrimaryIdentity
                </p>
                <p style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-secondary);">
                    @PortfolioData.CP · @PortfolioData.TCC · @PortfolioData.AI
                </p>
                @* <p style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-secondary);">
                    @PortfolioData.Location · @PortfolioData.EmailAddress · @PortfolioData.UniversityShort
                </p> *@
            </div>

            <div class="hero-cta-row">
                @if (PortfolioData.IsResumePdfUploaded)
                {
                    <a href="@PortfolioData.ResumePdfPath"
                       download
                       class="btn btn-primary">
                        <span>Download Resume PDF</span>
                        <span>↓</span>
                    </a>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="TogglePdfNotice">
                        <span>Download Resume PDF</span>
                    </button>
                }
                <a href="mailto:@PortfolioData.EmailAddress" class="btn btn-ghost">
                    <span>Contact via Email</span>
                </a>
            </div>
        </div>

        @if (_showPdfConfigNotice && !PortfolioData.IsResumePdfUploaded)
        {
            <div class="placeholder-callout" style="margin-bottom: 2rem;">
                Updated Resume Coming Soon...
            </div>
        }

        <!-- CV Sheet Container -->
        <div style="display: flex; flex-direction: column; gap: 2.5rem;">
            <!-- 01. Executive Summary -->
            <section class="timeline-node">
                <div class="section-index-tag">01 // SUMMARY</div>
                <p style="font-size: 0.98rem; color: var(--text-secondary); line-height: 1.75;">
                    @PortfolioData.HeroIntroduction
                </p>
            </section>

            <!-- 02. Education -->
            <section class="timeline-node">
                <div class="section-index-tag">02 // EDUCATION</div>
                @foreach (var edu in PortfolioData.EducationTimeline)
                {
                    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.35rem;">
                        <h2 style="font-family: var(--font-display); font-size: 1.25rem;">@edu.Institution</h2>
                        <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-primary);">
                            @edu.EnrollmentYear – @edu.ExpectedGraduationYear (@edu.CurrentStageCode)
                        </span>
                    </div>
                    <p style="font-size: 0.95rem; color: var(--text-primary); margin-bottom: 0.75rem;">
                        @edu.DegreeName — @edu.CurrentStageDescription
                    </p>
                    <div class="tag-cluster">
                        @foreach (var course in edu.RelevantCoursework)
                        {
                            <span class="tech-tag">@course</span>
                        }
                    </div>
                }
            </section>

            <!-- 03. Technical Skills (Working With & Familiar With) -->
            <section class="timeline-node">
                <div class="section-index-tag">03 // TECHNICAL COMPETENCIES</div>
                <div style="margin-bottom: 1.25rem;">
                    <h3 style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--status-working); margin-bottom: 0.5rem;">
                        WORKING WITH (DAILY / PRIMARY STACK)
                    </h3>
                    <div class="tag-cluster" style="margin-top: 0;">
                        @foreach (var skill in PortfolioData.Skills.Where(s => s.Status == SkillStatus.WorkingWith))
                        {
                            <span class="tech-tag" style="color: var(--text-primary);">@skill.Name</span>
                        }
                    </div>
                </div>

                <div>
                    <h3 style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--status-familiar); margin-bottom: 0.5rem;">
                        FAMILIAR WITH
                    </h3>
                    <div class="tag-cluster" style="margin-top: 0;">
                        @foreach (var skill in PortfolioData.Skills.Where(s => s.Status == SkillStatus.FamiliarWith))
                        {
                            <span class="tech-tag">@skill.Name</span>
                        }
                    </div>
                </div>
            </section>

            <!-- 04. Software Engineering Projects -->
            <section class="timeline-node">
                <div class="section-index-tag">04 // PROJECTS</div>
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    @foreach (var proj in PortfolioData.Projects)
                    {
                        <div style="border-bottom: 1px solid var(--border-grid); padding-bottom: 1rem;">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;">
                                <h3 style="font-family: var(--font-display); font-size: 1.15rem;">
                                    <a href="/projects/@proj.Slug">@proj.Title</a>
                                </h3>
                                <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-primary);">
                                    Status: @FormatProjectStatus(proj.Status)
                                </span>
                            </div>
                            <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0.35rem 0 0.6rem;">
                                @proj.Tagline
                            </p>
                            <div class="tag-cluster" style="margin-top: 0;">
                                @foreach (var t in proj.TechStack)
                                {
                                    <span class="tech-tag">@t</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- 05. Competitive Programming & Contests -->
            <section class="timeline-node">
                <div class="section-index-tag">05 // COMPETITIVE PROGRAMMING &amp; CONTESTS</div>
                <ul style="display: flex; flex-direction: column; gap: 0.65rem;">
                    @foreach (var contest in PortfolioData.ContestJourney)
                    {
                        <li style="font-size: 0.92rem; color: var(--text-secondary);">
                            <strong style="color: var(--text-primary);">@contest.ContestName (@contest.DateDisplay):</strong>
                            @contest.ParticipationStage — @contest.KeyTakeaway
                        </li>
                    }
                </ul>
            </section>

            <!-- 06. Leadership, Brand & Extracurricular Experience -->
            <section class="timeline-node">
                <div class="section-index-tag">06 // LEADERSHIP, BRAND &amp; CAMPUS ACTIVITIES</div>
                <div style="margin-bottom: 1.25rem;">
                    <h3 style="font-family: var(--font-display); font-size: 1.1rem; color: var(--accent-pcbhai);">
                        Founder &amp; Creator — pcBhai
                    </h3>
                    <p style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.25rem;">
                        Built a technology education channel (@PortfolioData.PcBhaiSubscribersStat YouTube subscribers, @PortfolioData.PcBhaiVideosStat videos) and assembled/delivered @PortfolioData.PcBhaiBuildsDeliveredStat custom desktop PCs across Bangladesh.
                    </p>
                </div>

                @foreach (var club in PortfolioData.ClubActivities)
                {
                    <div style="margin-top: 1rem;">
                        <h3 style="font-family: var(--font-display); font-size: 1.05rem;">
                            @club.OrganizationName — @club.Role (@club.Period)
                        </h3>
                        <p style="font-size: 0.88rem; color: var(--text-secondary); margin-top: 0.25rem;">
                            @club.Summary
                        </p>
                    </div>
                }
            </section>
        </div>
    </div>
</section>

@code {
    private bool _showPdfConfigNotice = true;

    private void TogglePdfNotice() => _showPdfConfigNotice = !_showPdfConfigNotice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("himelPortfolio.scrollToTop");
        }
    }
    private static string FormatProjectStatus(ProjectStatus status) => status switch
    {
        ProjectStatus.Completed => "Completed",
        ProjectStatus.InProgress => "In Progress",
        ProjectStatus.Planned => "Planned",
        _ => status.ToString()
    };
}