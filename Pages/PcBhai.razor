<!-- 10. Facebook Page & Community Hub -->
<section class="section-block" style="border-bottom: none;">
    <div class="container-frame">
        <div class="timeline-node" style="padding: 2.5rem; border-color: rgba(242, 153, 74, 0.4);">
            <div class="section-index-tag" style="color: var(--accent-pcbhai);">COMMUNITY // pcBhai YT | PAGE &amp; GROUP</div>
            <h2 class="section-title" style="margin-bottom: 0.65rem;">
                Join the pcBhai Community.
            </h2>
            <p style="font-size: 1rem; color: var(--text-secondary); max-width: 66ch; line-height: 1.7; margin-bottom: 1.75rem;">
                Explore PC building guides, component reviews, hardware comparisons, buying advice, and troubleshooting videos.
                Connect with fellow PC builders, ask component compatibility questions, and get troubleshooting help in the <strong style="color: var(--text-primary);">@PortfolioData.FacebookGroupName</strong> community and official Facebook page.
            </p>
            <div class="hero-cta-row">

                <a href="@PortfolioData.YouTubeChannelUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn"
                   style="background: #FF0000; border: 1px solid #FF0000; color: #FFFFFF; font-weight: 600; display: inline-flex; align-items: center; gap: 0.55rem; box-shadow: 0 4px 14px rgba(255, 0, 0, 0.25);">
                    <svg width="18" height="13" viewBox="0 0 24 17" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;">
                        <path d="M23.498 2.656a3.016 3.016 0 0 0-2.122-2.136C19.505 0 12 0 12 0S4.495 0 2.624.52A3.016 3.016 0 0 0 .502 2.656C0 4.539 0 8.47 0 8.47s0 3.931.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.52 9.376.52 9.376.52s7.505 0 9.376-.52a3.016 3.016 0 0 0 2.122-2.136C24 12.401 24 8.47 24 8.47s0-3.931-.502-5.814zM9.545 12.098V4.842L15.818 8.47l-6.273 3.628z" fill="#FFFFFF" />
                    </svg>
                    <span>Open pcBhai YouTube Channel</span>
                    <span>↗</span>
                </a>
                <a href="@PortfolioData.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="background: var(--accent-pcbhai); border-color: var(--accent-pcbhai);">
                    <span>Visit pcBhai Facebook Page</span>
                    <span>↗</span>
                </a>
                
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string[] _videoCategories =
    [
        "All",
        "PC Build Guide",
        "Monitors",
        "Buying Guides",
        "GPU / CPU",
        "Tutorials"
    ];

    private string _selectedCategory = "All";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("himelPortfolio.scrollToTop");
        }
    }

    private IEnumerable<PcBhaiVideoItem> GetFilteredVideos()
    {
        if (_selectedCategory == "All")
        {
            return PortfolioData.PcBhaiVideos;
        }

        return PortfolioData.PcBhaiVideos.Where(v =>
            string.Equals(v.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase));
    }
}