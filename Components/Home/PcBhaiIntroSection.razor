<section id="pcbhai-intro" class="section-block" aria-labelledby="pcbhai-home-heading">
    <div class="container-frame">
        <div class="pcbhai-banner-frame">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 2rem;">
                <div style="max-width: 720px;">
                    <span class="pcbhai-badge">FOUNDER &amp; CREATOR // pcBhai</span>
                    <h2 id="pcbhai-home-heading" class="section-title" style="margin-bottom: 0.75rem;">
                        @PortfolioData.PcBhaiHeadline
                    </h2>
                    <p style="font-size: 1.02rem; color: var(--text-secondary); line-height: 1.7;">
                        @PortfolioData.PcBhaiStoryOverview
                    </p>
                </div>

                <div class="hero-cta-row">
                    <a href="/pcbhai" class="btn btn-primary" style="background: var(--accent-pcbhai); border-color: var(--accent-pcbhai);">
                        <span>Explore pcBhai</span>
                        <span>→</span>
                    </a>
                    <a href="@PortfolioData.YouTubeChannelUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn"
                       style="background: #FF0000; border: 1px solid #FF0000; color: #FFFFFF; font-weight: 600; display: inline-flex; align-items: center; gap: 0.55rem; box-shadow: 0 4px 14px rgba(255, 0, 0, 0.25);">
                        <svg width="18" height="13" viewBox="0 0 24 17" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;">
                            <path d="M23.498 2.656a3.016 3.016 0 0 0-2.122-2.136C19.505 0 12 0 12 0S4.495 0 2.624.52A3.016 3.016 0 0 0 .502 2.656C0 4.539 0 8.47 0 8.47s0 3.931.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.52 9.376.52 9.376.52s7.505 0 9.376-.52a3.016 3.016 0 0 0 2.122-2.136C24 12.401 24 8.47 24 8.47s0-3.931-.502-5.814zM9.545 12.098V4.842L15.818 8.47l-6.273 3.628z" fill="#FFFFFF" />
                        </svg>
                        <span>YouTube Channel</span>
                        <span>↗</span>
                    </a>
                </div>
            </div>

            <!-- Verified pcBhai Metrics Bar -->
            <div class="spec-matrix" style="margin-top: 0; margin-bottom: 2.25rem;">
                <div class="spec-cell">
                    <div class="spec-cell-label">BRAND IDENTITY</div>
                    <div class="spec-cell-val" style="color: var(--accent-pcbhai);">pcBhai</div>
                </div>
                <div class="spec-cell">
                    <div class="spec-cell-label">YOUTUBE SUBSCRIBERS</div>
                    <div class="spec-cell-val">@PortfolioData.PcBhaiSubscribersStat Subscribers</div>
                </div>
                <div class="spec-cell">
                    <div class="spec-cell-label">PUBLISHED CONTENT</div>
                    <div class="spec-cell-val">@PortfolioData.PcBhaiVideosStat Tech Videos</div>
                </div>
                <div class="spec-cell">
                    <div class="spec-cell-label">HARDWARE OPERATIONS</div>
                    <div class="spec-cell-val">@PortfolioData.PcBhaiBuildsDeliveredStat PCs Built in Bangladesh</div>
                </div>
            </div>

            <!-- Featured Video Previews -->
            <div style="margin-bottom: 1.75rem;">
                <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-pcbhai); letter-spacing: 0.06em; margin-bottom: 1rem;">
                    FEATURED: pcBhai HARDWARE GUIDES &amp; BUILDS
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.25rem;">
                    @foreach (var video in PortfolioData.PcBhaiVideos.Where(v => v.IsFeatured).Take(3))
                    {
                        <YouTubeLiteEmbed Video="video" />
                    }
                </div>
            </div>

            <!-- Community & Social Row -->
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--border-grid); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary);">
                <div>
                    Community Group: <strong style="color: var(--text-primary);">@PortfolioData.FacebookGroupName</strong>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
                    <a href="@PortfolioData.FacebookPageUrl" target="_blank" rel="noopener noreferrer" style="color: var(--accent-pcbhai);">
                        pcBhai Facebook Page ↗
                    </a>
                    <a href="/pcbhai" style="color: var(--text-primary); text-decoration: underline;">
                        View All Guides &amp; Build Gallery →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>