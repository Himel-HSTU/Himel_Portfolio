<section id="icpc-journey" class="section-block" aria-labelledby="icpc-heading">
    <div class="container-frame">
        <div class="section-grid-split">
            <!-- Left Rail -->
            <SectionHeader DomainTag="CONTESTS // ICPC &amp; IUPC"
                           Title="ICPC / IUPC Journey."
                           Subtitle="Some good attempts, some disappointing results, last-minute learning, post-contest regrets, and plenty of things I still have to figure out." />

            <!-- Right Content Canvas -->
            <div class="timeline-list">
                @foreach (var contest in PortfolioData.ContestJourney)
                {
                    <article class="timeline-node">
                        <div class="timeline-meta-row">
                            <span>@contest.DateDisplay · @contest.Category</span>
                            <span style="border: 1px solid var(--border-grid); background: var(--bg-obsidian); padding: 0.15rem 0.55rem; color: var(--text-primary);">
                                @contest.ParticipationStage
                            </span>
                        </div>

                        <h3 class="timeline-heading">@contest.ContestName</h3>

                        <div class="spec-matrix" style="margin: 1rem 0;">
                            <div class="spec-cell">
                                <div class="spec-cell-label">TEAM / REPRESENTATION</div>
                                <div class="spec-cell-val" style="font-size: 0.9rem;">@contest.TeamName</div>
                            </div>
                            <div class="spec-cell">
                                <div class="spec-cell-label">RESULT / STANDING LOG</div>
                                <div class="spec-cell-val" style="font-size: 0.9rem;">@contest.ResultOrStandingDisplay</div>
                            </div>
                        </div>

                        <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.65;">
                            @contest.KeyTakeaway
                        </p>
                    </article>
                }

                <!-- Horizontal Summary Bar: 50+ Intra-HSTU Programming Contests -->
                <div class="timeline-node" style="border-left: 3px solid var(--accent-primary); padding: 1.25rem 1.5rem;">
                    <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-primary); letter-spacing: 0.06em; margin-bottom: 0.3rem;">
                        CAMPUS ARENA // INTRA-UNIVERSITY CONTEST LOG
                    </div>
                    <div style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.85rem;">
                        Participated in 50+ Intra-HSTU Programming Contests (Practice, Team Formation), Ranked Among Top 30%
                    </div>

                    <div class="tag-cluster" style="margin-top: 0;">
                        <span class="tech-tag">Intra-HSTU Contests</span>
                        <span class="tech-tag">Team Formation Contests</span>
                        <span class="tech-tag">Individual Practice Rounds</span>
                        <span class="tech-tag">Programmers Arena</span>
                        <span class="tech-tag">Top 30% Standing</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>