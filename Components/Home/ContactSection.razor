<section id="contact" class="section-block" style="border-bottom: none;" aria-labelledby="contact-heading">
    <div class="container-frame">
        <div class="timeline-node" style="padding: 3rem 2.5rem; border-color: var(--accent-primary-border);">
            <div class="section-index-tag">COMMUNICATION // DIRECT CHANNEL</div>

            <h2 id="contact-heading"
                style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 1rem;">
                LET'S BUILD SOMETHING MEANINGFUL<span class="accent-dot">.</span>
            </h2>

            <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 62ch; line-height: 1.7; margin-bottom: 2rem;">

                <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 62ch; line-height: 1.7; margin-bottom: 2rem;">
                    Open to meaningful conversations, engineering collaborations, career opportunities, and creative ideas. Whether it's about software engineering, .NET, AI, Competitive Programming, or pcBhai, I'd be glad to hear from you.
                </p>

            </p>

            <!-- Primary Email Action Row -->
            <div class="hero-cta-row" style="margin-bottom: 2.5rem;">
                <a href="mailto:@PortfolioData.EmailAddress?subject=Engineering%20Inquiry%20—%20HIMEL%20Portfolio"
                   class="btn btn-primary">
                    <span>Send Direct Email (@PortfolioData.EmailAddress)</span>
                    <span>↗</span>
                </a>
                <a href="/resume" class="btn btn-secondary">
                    <span>View Full Resume / CV</span>
                </a>
            </div>

            <!-- Verified Social & Professional Network Matrix -->
            <div class="spec-matrix">
                <a href="@PortfolioData.FacebookPersonalUrl" target="_blank" rel="noopener noreferrer" class="spec-cell">
                    <div class="spec-cell-label">FACEBOOK</div>
                    <div class="spec-cell-val" style="font-size: 0.92rem;">Personal Network ↗</div>
                </a>
                <a href="@PortfolioData.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="spec-cell">
                    <div class="spec-cell-label">LINKEDIN</div>
                    <div class="spec-cell-val" style="font-size: 0.92rem;">Professional Network ↗</div>
                </a>
                <a href="@PortfolioData.GitHubUrl" target="_blank" rel="noopener noreferrer" class="spec-cell">
                    <div class="spec-cell-label">GITHUB</div>
                    <div class="spec-cell-val" style="font-size: 0.92rem;">Code &amp; Repositories ↗</div>
                </a>
                <a href="@PortfolioData.YouTubeChannelUrl" target="_blank" rel="noopener noreferrer" class="spec-cell">
                    <div class="spec-cell-label">YOUTUBE</div>
                    <div class="spec-cell-val" style="font-size: 0.92rem; color: var(--accent-pcbhai);">pcBhai YT ↗</div>
                </a>
                <a href="@PortfolioData.FacebookPageUrl" target="_blank" rel="noopener noreferrer" class="spec-cell">
                    <div class="spec-cell-label">FACEBOOK</div>
                    <div class="spec-cell-val" style="font-size: 0.92rem;">pcBhai Page &amp; Community ↗</div>
                </a>
            </div>
        </div>
    </div>
</section>