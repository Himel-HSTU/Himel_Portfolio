<section id="competitive-programming" class="section-block" aria-labelledby="cp-heading">
    <div class="container-frame">
        <div class="section-grid-split">
            <!-- Left Rail -->
            <SectionHeader DomainTag="DSA // PROBLEM SOLVING"
                           Title="Competitive Programming.">
                <div style="border: 1px solid var(--border-grid); background: var(--bg-slate); padding: 1.35rem; position: relative;">
                    <!-- Top Story Tag -->
                    <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-primary); letter-spacing: 0.06em; margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                        <span>THE BEGINNING // CP</span>
                        <span style="color: #FF4D4F;">● CF_RED</span>
                    </div>

                    <!-- Intro Hook -->
                    <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 0.9rem;">
                        Back in <u>Class 8</u>, one of our school teachers went around the classroom asking every student, one by one, what they dreamed of becoming.
                    </p>

                    <!-- Classroom Dialogue Box -->
                    <div style="border-left: 2px solid var(--border-grid); padding-left: 0.85rem; margin-bottom: 0.95rem; font-family: var(--font-mono); font-size: 0.76rem; line-height: 1.65;">
                        <div style="color: var(--text-muted);">
                            Classmates: "Doctor." "Engineer." "Lawyer." "Govt. Job."
                        </div>
                        <div style="color: var(--text-primary); margin-top: 0.3rem;">
                            Curious Me: <span style="color: #FF4D4F; font-weight: 600;">"I want to be a RED CODER!"</span>
                        </div>
                    </div>

                    <!-- The Backstory & Tutor Credit -->
                    <p style="font-size: 0.86rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 1rem;">
                        The funny part? Kid me didn't even truly know what a Red Coder was. Just a few days earlier, my private tutor <strong style="color: var(--text-primary);">Md. Moshiur Rahman</strong> <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-muted);">(CSE-17 @("@")HSTU · Senior Software Engineer, Samsung R&amp;D Institute Bangladesh)</span> had introduced me to Competitive Programming and Codeforces—showing me the rating graph and telling me that if I did well, I'd reach the Red Zone and be called a <span style="color: #FF4D4F; font-weight: 500;">Red Coder</span>.
                    </p>

                    <!-- Final Honest Reflection -->
                    <div style="border-top: 1px solid var(--border-grid); padding-top: 0.85rem; font-size: 0.86rem; line-height: 1.6; color: var(--text-secondary);">
                        I still cherish the audacity of that dream.
                        <span style="display: block; margin-top: 0.35rem; color: var(--text-primary); font-weight: 500; text-decoration: underline; text-decoration-color: var(--accent-primary); text-underline-offset: 4px;">
                            And let's be honest—I have to admit that I failed myself here !!!
                        </span>
                    </div>
                </div>
            </SectionHeader>

            <!-- Right Content Canvas -->
            <div>
                <!-- 4 Primary Judge Cards Grid -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.25rem;">
                    @foreach (var profile in PortfolioData.CpProfiles)
                    {
                        <article class="timeline-node" style="display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                                    <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; color: var(--text-primary);">
                                        @profile.PlatformName
                                    </h3>
                                    <span class="tech-tag" style="color: var(--accent-primary);">
                                        @profile.HandlePlaceholder
                                    </span>
                                </div>

                                <p style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-primary); margin-bottom: 0.65rem;">
                                    @profile.RankTitleDisplay
                                </p>

                                <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
                                    @profile.Notes
                                </p>
                            </div>

                            <div>
                                <!-- Platform Statistics Grid -->
                                <div class="telemetry-grid" style="margin-bottom: 1rem;">
                                    <div class="telemetry-cell">
                                        <div class="telemetry-label">PROBLEMS SOLVED</div>
                                        <div class="telemetry-value" style="font-size: 0.88rem;">@profile.SolvedCountDisplay</div>
                                    </div>
                                    <div class="telemetry-cell">
                                        <div class="telemetry-label">MAX RATING</div>
                                        <div class="telemetry-value" style="font-size: 0.88rem;">@profile.MaxRatingDisplay</div>
                                    </div>
                                </div>

                                <a href="@profile.ProfileUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-secondary"
                                   style="width: 100%; justify-content: space-between;">
                                    <span>View @profile.PlatformName Profile</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        </article>
                    }
                </div>

                <!-- Horizontal Summary Bar: 200+ Problems Across Other Judges -->
                <div class="timeline-node" style="margin-top: 1.25rem; border-left: 3px solid var(--accent-primary); padding: 1.25rem 1.5rem;">
                    <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-primary); letter-spacing: 0.06em; margin-bottom: 0.3rem;">
                        EXTENDED ARCHIVE // ADDITIONAL ONLINE JUDGES
                    </div>
                    <div style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.85rem;">
                        200+ Problems Solved Across Other Different Judges
                    </div>

                    <div class="tag-cluster" style="margin-top: 0;">
                        <span class="tech-tag">CSES</span>
                        <span class="tech-tag">HackerRank</span>
                        <span class="tech-tag">SPOJ</span>
                        <span class="tech-tag">LightOJ</span>
                        <span class="tech-tag">VJudge</span>
                        <span class="tech-tag">Beecrowd</span>
                        <span class="tech-tag">GeeksforGeeks (GFG)</span>
                        <span class="tech-tag">Toph</span>
                        <span class="tech-tag">UVa</span>
                        <span class="tech-tag">HackerEarth</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>